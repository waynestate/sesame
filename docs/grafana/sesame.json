{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus data source that scrapes HELMET's /metrics endpoint, where SESAME's sign-in counter shows up.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SESAME sign-ins across the fleet: how many finish, how many succeed, and when an identity provider goes down. Reads sesame_logins_total from HELMET's /metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Sign-ins",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Sign-ins that finished in the selected time range, every outcome. A trip to the identity provider is not counted.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "locale",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2F9C86",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(sesame_logins_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "Sign-ins",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Sign-ins",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The share of finished sign-ins that ended with a signed-in user.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#D9653B",
                "value": null
              },
              {
                "color": "#D6A73C",
                "value": 0.8
              },
              {
                "color": "#2F9C86",
                "value": 0.95
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(sesame_logins_total{job=~\"$job\", instance=~\"$instance\", outcome=\"success\"}[$__range])) / sum(increase(sesame_logins_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "Success rate",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Success rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Sign-ins that hit an identity provider SESAME could not reach, that timed out, or that answered with a 5xx (ProviderUnavailable). Anything above zero means CAS, Entra or the IdP was down for an app.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "locale",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2F9C86",
                "value": null
              },
              {
                "color": "#D9653B",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(sesame_logins_total{job=~\"$job\", instance=~\"$instance\", outcome=\"unavailable\"}[$__range])) or vector(0)",
          "legendFormat": "Identity provider unavailable",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Identity provider unavailable",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Verified identities the app's resolver turned away (findOrImportUser returned null): people with no access, not attackers.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "locale",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8FA39C",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(sesame_logins_total{job=~\"$job\", instance=~\"$instance\", outcome=\"refused\"}[$__range])) or vector(0)",
          "legendFormat": "Refused by the app",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Refused by the app",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Finished sign-ins per minute, stacked by outcome: success, failed (a bad ticket, token or assertion), refused (the app said no) and unavailable (the identity provider was down).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2F9C86"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D6A73C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "refused"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8FA39C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unavailable"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D9653B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B7B0A2"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(sesame_logins_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Sign-ins per minute by outcome",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Finished sign-ins per minute by SESAME driver (cas, gateway, oauth2, oidc, saml, fake).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (driver) (rate(sesame_logins_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "{{driver}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Sign-ins per minute by driver",
      "type": "timeseries"
    },
    {
      "type": "row",
      "title": "When it goes wrong",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Sign-ins per minute that could not reach the identity provider, by app instance. One app alone points at its network or its HTTP client; every app at once points at the provider.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (rate(sesame_logins_total{job=~\"$job\", instance=~\"$instance\", outcome=\"unavailable\"}[$__rate_interval])) * 60",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Identity provider unavailable, by app",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The share of finished sign-ins the driver refused, by driver. A sudden rise after a deploy usually means a config value (a URL, an audience, a key) changed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (driver) (rate(sesame_logins_total{job=~\"$job\", instance=~\"$instance\", outcome=\"failed\"}[$__rate_interval])) / sum by (driver) (rate(sesame_logins_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{driver}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Failed share by driver",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Finished sign-ins in the selected time range, by app instance, driver and outcome.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "locale",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "App"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 88
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Driver"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 64
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 96
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sign-ins"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "id": 11,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Sign-ins",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (instance, driver, outcome) (increase(sesame_logins_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "instance": "App",
              "driver": "Driver",
              "outcome": "Outcome",
              "Value": "Sign-ins"
            },
            "indexByName": {
              "instance": 0,
              "driver": 1,
              "outcome": 2,
              "Value": 3
            }
          }
        }
      ],
      "title": "Sign-ins by app",
      "type": "table"
    },
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 12,
      "options": {
        "mode": "markdown",
        "content": "**Where the numbers come from.** SESAME counts every finished sign-in as `sesame_logins_total` in HELMET's metrics store, so it is scraped from HELMET's `/metrics` with the rest of the app. Turn it on with `SESAME_METRICS_ENABLED=true` next to HELMET's request metrics. Labels are the driver and the outcome only: never a username, an IP or a session ID. Guide: [Counting sign-ins](https://sesame.apps.wayne.edu/docs/guides/metrics.html)."
      },
      "title": "About this dashboard",
      "type": "text"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "sesame",
    "wsu"
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(sesame_logins_total, job)",
        "query": {
          "query": "label_values(sesame_logins_total, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "options": []
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(sesame_logins_total{job=~\"$job\"}, instance)",
        "query": {
          "query": "label_values(sesame_logins_total{job=~\"$job\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "SESAME sign-ins",
  "uid": "sesame-signins",
  "version": 1,
  "weekStart": ""
}
