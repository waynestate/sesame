{
    "name": "waynestate/sesame",
    "description": "Wayne State's protocol-neutral auth library: it returns a verified identity and leaves the session to the app.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-simplexml": "*",
        "lcobucci/jwt": "^5.6",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "symfony/http-foundation": "^6.4 || ^7.4"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 client for the cas driver",
        "laravel/framework": "For the Laravel adapter",
        "symfony/http-client": "A PSR-18 client for the cas driver"
    },
    "autoload": {
        "psr-4": {
            "Waynestate\\Sesame\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Sesame\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Waynestate\\Sesame\\Laravel\\SesameServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
